#include <stdio.h>
#include <stdlib.h>
#include <time.h>
#include <string.h>

#define MAX_LEITURAS   100
#define LIMITE_MIN     18.0f
#define LIMITE_MAX     30.0f

typedef struct {
    float  valor;
    time_t instante;
} Leitura;

typedef struct {
    Leitura itens[MAX_LEITURAS];
    int     total;
    int     proximo;
} Historico;


void historico_iniciar(Historico *h)
{
    h->total   = 0;
    h->proximo = 0;
}

void historico_inserir(Historico *h, float valor)
{
    h->itens[h->proximo].valor    = valor;
    h->itens[h->proximo].instante = time(NULL);

    h->proximo = (h->proximo + 1) % MAX_LEITURAS;
    if (h->total < MAX_LEITURAS)
        h->total++;
}

int historico_estatisticas(const Historico *h, float *min, float *max, float *media)
{
    if (h->total == 0)
        return 0;

    float soma = 0.0f;
    *min = *max = h->itens[0].valor;

    for (int i = 0; i < h->total; i++) {
        float v = h->itens[i].valor;
        if (v < *min) *min = v;
        if (v > *max) *max = v;
        soma += v;
    }
    *media = soma / h->total;
    return 1;
}


typedef enum { ESTADO_OK, ESTADO_BAIXA, ESTADO_ALTA } Estado;

Estado verificar(float t)
{
    if (t < LIMITE_MIN) return ESTADO_BAIXA;
    if (t > LIMITE_MAX) return ESTADO_ALTA;
    return ESTADO_OK;
}

void imprimir_leitura(float t)
{
    char hora[32];
    time_t agora = time(NULL);
    strftime(hora, sizeof(hora), "%d/%m/%Y %H:%M:%S", localtime(&agora));

    printf("[%s] Temperatura: %.2f C  -> ", hora, t);

    switch (verificar(t)) {
        case ESTADO_BAIXA:
            printf("ALERTA: abaixo do limite (%.1f C)\n", LIMITE_MIN);
            break;
        case ESTADO_ALTA:
            printf("ALERTA: acima do limite (%.1f C)\n", LIMITE_MAX);
            break;
        default:
            printf("normal\n");
            break;
    }
}

float ler_sensor(void)
{
    return 15.0f + (rand() % 2001) / 100.0f;
}

/* ---------- relatorio ---------- */

void mostrar_relatorio(const Historico *h)
{
    float min, max, media;

    if (!historico_estatisticas(h, &min, &max, &media)) {
        printf("\nNenhuma leitura registrada ainda.\n");
        return;
    }

    printf("\n--- Relatorio (%d leituras) ---\n", h->total);
    printf("Minima : %.2f C\n", min);
    printf("Maxima : %.2f C\n", max);
    printf("Media  : %.2f C\n", media);
    printf("Faixa segura: %.1f C a %.1f C\n", LIMITE_MIN, LIMITE_MAX);
    printf("-------------------------------\n");
}


void limpar_entrada(void)
{
    int c;
    while ((c = getchar()) != '\n' && c != EOF) { }
}

int main(void)
{
    Historico h;
    int opcao;

    srand((unsigned) time(NULL));
    historico_iniciar(&h);

    printf("=== Monitor de Temperatura ===\n");

    do {
        printf("\n1 - Registrar leitura manual\n");
        printf("2 - Ler sensor (simulado)\n");
        printf("3 - Simular N leituras\n");
        printf("4 - Ver relatorio\n");
        printf("5 - Listar historico\n");
        printf("0 - Sair\n");
        printf("Opcao: ");

        if (scanf("%d", &opcao) != 1) {
            limpar_entrada();
            printf("Entrada invalida.\n");
            continue;
        }

        switch (opcao) {
            case 1: {
                float t;
                printf("Temperatura em C: ");
                if (scanf("%f", &t) != 1) {
                    limpar_entrada();
                    printf("Valor invalido.\n");
                    break;
                }
                historico_inserir(&h, t);
                imprimir_leitura(t);
                break;
            }
            case 2: {
                float t = ler_sensor();
                historico_inserir(&h, t);
                imprimir_leitura(t);
                break;
            }
            case 3: {
                int n;
                printf("Quantas leituras? ");
                if (scanf("%d", &n) != 1 || n <= 0) {
                    limpar_entrada();
                    printf("Quantidade invalida.\n");
                    break;
                }
                for (int i = 0; i < n; i++) {
                    float t = ler_sensor();
                    historico_inserir(&h, t);
                    imprimir_leitura(t);
                }
                break;
            }
            case 4:
                mostrar_relatorio(&h);
                break;
            case 5: {
                char hora[32];
                printf("\n--- Historico ---\n");
                for (int i = 0; i < h.total; i++) {
                    strftime(hora, sizeof(hora), "%d/%m %H:%M:%S",
                             localtime(&h.itens[i].instante));
                    printf("%3d) %s  %.2f C%s\n", i + 1, hora, h.itens[i].valor,
                           verificar(h.itens[i].valor) == ESTADO_OK ? "" : "  (*)");
                }
                break;
            }
            case 0:
                printf("Encerrando.\n");
                break;
            default:
                printf("Opcao inexistente.\n");
        }
    } while (opcao != 0);

    return 0;
}
